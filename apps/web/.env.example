# ============================================
# 247GBS Audit — Web Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.

# Source of truth for the frontend listen port (`next dev` / `next start` respect PORT).
PORT=9009

# Backend API base URL (client-exposed)
# Must match the backend PORT in apps/api/.env
# Dev: http://localhost:9008/api/v1
# Prod: https://247gbsaudit-api.centralhubsolution.com/api/v1
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_URL=

# AI (Google Gemini) — server-side only
# Get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
