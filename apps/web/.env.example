# ============================================
# 247GBS Audit — Web Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# Backend API base URL (client-exposed)
# Dev: http://localhost:3001/api/v1
# Prod: https://247-gbs-audit-backend.vercel.app/api/v1
NEXT_PUBLIC_API_BASE_URL=

# AI (Google Gemini) — server-side only
# Get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
