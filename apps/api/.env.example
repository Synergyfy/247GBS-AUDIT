# ============================================
# 247GBS Audit — API Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# --- Server ---
# Source of truth for the API listen port. Change this to run the backend on another port.
PORT=9008
NODE_ENV=development

# --- App Config ---
APP_NAME=247GBS Audit

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_NAME=audit_db
# TypeORM schema sync: ALWAYS false by default. Set true ONLY for throwaway
# local dev (NODE_ENV=development). Never true in prod/staging — use migrations.
TYPEORM_SYNC=false

# --- CORS ---
# Allow no-origin requests (curl/mobile/server-to-server). Default: true in dev,
# false in production. Explicitly set false in prod.
ALLOW_NO_ORIGIN=false

# --- Authentication (JWT) ---
# Generate strong random strings (min 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token expiry durations (e.g. 15m, 1h, 7d)
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Encryption key for MCOM token storage (32 bytes hex)
JWT_SECRET=

# --- AI (Google Gemini) ---
# Get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- MCOM Solutions Central Hub ---
MCOM_SOLUTIONS_URL=https://api.centralhubsolution.com
MCOM_CLIENT_ID=247gbs-audit
MCOM_CLIENT_SECRET=
MCOM_API_KEY=
MCOM_HMAC_SECRET=
MCOM_WEBHOOK_SECRET=

# --- MCOM Service Mesh (inbound M2M / partner data sharing) ---
# Peers permitted to call THIS app's /partner/audit-data endpoints (deny-by-default).
# Comma-separated clientIds; "*" allows all registered callers. If unset, the
# allow-list is refreshed from the Central service registry (/api/v1/ecosystem/services).
MCOM_ALLOWED_CALLERS=fundordonate
# Override only if Central's JWKS lives on a different host than MCOM_SOLUTIONS_URL.
# MCOM_JWKS_URL=https://api.centralhubsolution.com/.well-known/jwks.json
# Expected token issuer claim. Defaults to mcom-solutions.
MCOM_SERVICE_ISSUER=mcom-solutions

# --- Outbound audit events to fundordonate (optional, OFF by default) ---
# Requires a mesh edge 247gbs-audit -> fundordonate and an inbound event scope
# agreed with the fundordonate team. No-op unless ENABLED=true AND BASE_URL set.
FUNDORDONATE_AUDIT_EVENTS_ENABLED=false
FUNDORDONATE_BASE_URL=
FUNDORDONATE_CLIENT_ID=fundordonate
FUNDORDONATE_AUDIT_EVENT_PATH=/api/v1/partner/audit-events
FUNDORDONATE_AUDIT_EVENT_SCOPE=audit:write

# --- MCOM Platform Config ---
MCOM_PLATFORM_SLUG=247gbs_audit
MCOM_REDIRECT_URI=http://localhost:9008/api/v1/auth/sso/callback
MCOM_SCOPES=profile email business
MCOM_MEMBERSHIP_URL=https://api.centralhubsolution.com
MCOM_WALLET_ENABLED=false

# --- Frontend ---
# Must match the frontend PORT in apps/web/.env
FRONTEND_URL=http://localhost:9009
# Comma-separated list of allowed CORS origins (production)
ALLOWED_ORIGINS=https://247gbsaudit.centralhubsolution.com

# --- Rate limiting ---
# Per-IP fixed-window window (seconds) and max requests for public endpoints
RATE_LIMIT_TTL_SECONDS=60
# Max public Pre-Audit submissions per IP per window
RATE_LIMIT_PRE_AUDIT=20

# --- Redis (OTP hashes, webhook dedup) ---
REDIS_URL=redis://localhost:6379
# HMAC pepper for OTP hashing (min 32 chars). NEVER commit the real value.
OTP_PEPPER=

# --- Mail (SMTP) ---
# Enable sending (transports only activate when SMTP_HOST is also set)
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on outgoing mail. Defaults to 247GBS Audit <no-reply@<host>>
MAIL_FROM=
# Recipient for internal notifications (SUPPORT / HUMAN_REVIEW routes)
MAIL_INTERNAL_TO=
