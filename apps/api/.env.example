# ============================================
# 247GBS Audit — API Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- App Config ---
APP_NAME=247GBS Audit

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=audit_db

# TypeORM schema auto-sync (true in dev, false in production)
DB_SYNC=true

# Enable SSL for database connection (true for cloud DBs)
DB_SSL=false

# --- Authentication (JWT) ---
# Generate strong random strings (min 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token expiry durations (e.g. 15m, 1h, 7d)
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- AI (Google Gemini) ---
# Get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
