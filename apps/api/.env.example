# ============================================
# 247GBS Audit — API Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- App Config ---
APP_NAME=247GBS Audit

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_NAME=audit_db

# --- Authentication (JWT) ---
# Generate strong random strings (min 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token expiry durations (e.g. 15m, 1h, 7d)
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Encryption key for MCOM token storage (32 bytes hex)
JWT_SECRET=

# --- AI (Google Gemini) ---
# Get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- MCOM Solutions Central Hub ---
MCOM_SOLUTIONS_URL=https://api.centralhubsolution.com
MCOM_CLIENT_ID=
MCOM_CLIENT_SECRET=
MCOM_API_KEY=
MCOM_HMAC_SECRET=
MCOM_WEBHOOK_SECRET=
SSO_SECRET=

# --- MCOM Platform Config ---
MCOM_PLATFORM_SLUG=247gbs-audit
MCOM_REDIRECT_URI=http://localhost:3000/auth/callback
MCOM_SCOPES=profile email business membership packages
MCOM_MEMBERSHIP_URL=https://api.centralhubsolution.com
MCOM_WALLET_ENABLED=false

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins (production)
# ALLOWED_ORIGINS=https://247gbsaudit.centralhubsolution.com
