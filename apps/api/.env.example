# ============================================
# 247GBS Audit — API Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- App Config ---
APP_NAME=247GBS Audit

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_NAME=audit_db

# --- Authentication (JWT) ---
# Generate strong random strings (min 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token expiry durations (e.g. 15m, 1h, 7d)
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Encryption key for MCOM token storage (32 bytes hex)
JWT_SECRET=

# --- AI (Google Gemini) ---
# Get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- MCOM Solutions Central Hub ---
MCOM_SOLUTIONS_URL=https://api.centralhubsolution.com
MCOM_CLIENT_ID=247gbs-audit
MCOM_CLIENT_SECRET=
MCOM_API_KEY=
MCOM_HMAC_SECRET=
MCOM_WEBHOOK_SECRET=

# --- MCOM Platform Config ---
MCOM_PLATFORM_SLUG=247gbs_audit
MCOM_REDIRECT_URI=http://localhost:3001/api/v1/auth/sso/callback
MCOM_SCOPES=profile email business
MCOM_MEMBERSHIP_URL=https://api.centralhubsolution.com
MCOM_WALLET_ENABLED=false

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins (production)
ALLOWED_ORIGINS=https://247gbsaudit.centralhubsolution.com

# --- Rate limiting ---
# Per-IP fixed-window window (seconds) and max requests for public endpoints
RATE_LIMIT_TTL_SECONDS=60
# Max public Pre-Audit submissions per IP per window
RATE_LIMIT_PRE_AUDIT=20

# --- Mail (SMTP) ---
# Enable sending (transports only activate when SMTP_HOST is also set)
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on outgoing mail. Defaults to 247GBS Audit <no-reply@<host>>
MAIL_FROM=
# Recipient for internal notifications (SUPPORT / HUMAN_REVIEW routes)
MAIL_INTERNAL_TO=
